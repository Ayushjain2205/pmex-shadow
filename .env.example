# Copy to .env and fill in. Never commit the real .env.
#
#   cp .env.example .env
#
# Only ONE value below is required: PMEX_CONTROL_AUTH_SECRET. Everything else has a
# working default. See the README's Setup section for the full walkthrough.

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────────────────────

# The control plane refuses to start without this (FR-C-7) — no default credentials,
# by design. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PMEX_CONTROL_AUTH_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# RECOMMENDED — chain data source
# ─────────────────────────────────────────────────────────────────────────────
#
# Optional (FR-W-7): the system is fully functional on the Data API alone. But the
# Data API only polls every PMEX_DATAAPI_POLL_INTERVAL_S (30s), and the shipped
# `tight`/`flat` profiles use max_fill_age_s: 5 — so on Data-API-only EVERY fill is
# skipped as `stale_fill`, unconditionally. Either enable the chain path here, or
# put your bots on the `loose` profile. This is the #1 "why are there no copies?"
# cause; see README § Step 3.
#
# Needs a real provider (Alchemy / QuickNode / Chainstack / dRPC). Free public
# endpoints subscribe fine but reject the eth_getLogs archive range that backfill
# after an outage depends on — see docs/VERIFIED.md addendum items 12-13.
#
#   POLYGON_WS_URL=wss://polygon-mainnet.g.alchemy.com/v2/<your-api-key>
#   POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/<your-api-key>
POLYGON_RPC_URL=
POLYGON_WS_URL=
# WS connections drop. Set a second provider and the watcher fails over, logging a WARN.
POLYGON_WS_URL_FALLBACK=

PMEX_SOURCES_CHAIN_ENABLED=1
PMEX_SOURCES_DATAAPI_ENABLED=1
PMEX_DATAAPI_POLL_INTERVAL_S=30

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE — defaults work as-is with docker compose
# ─────────────────────────────────────────────────────────────────────────────

POSTGRES_PASSWORD=changeme
PMEX_DATABASE_URL=postgresql://postgres:changeme@db:5432/pmex

# ─────────────────────────────────────────────────────────────────────────────
# CONTROL PLANE
# ─────────────────────────────────────────────────────────────────────────────

# Read-only until you explicitly enable writes (FR-C-8). Leave at 0 to browse the
# dashboard without being able to change bot params from it.
PMEX_CONTROL_ALLOW_WRITES=0

# Host port the dashboard is published on; the container-internal port is always
# 8080, and it binds 127.0.0.1 only. Change if 8877 collides on your machine.
PMEX_CONTROL_HOST_PORT=8877

# ─────────────────────────────────────────────────────────────────────────────
# POLYMARKET ENDPOINTS — defaults point at production
# ─────────────────────────────────────────────────────────────────────────────

PMEX_CLOB_BASE_URL=https://clob.polymarket.com
PMEX_DATA_API_BASE_URL=https://data-api.polymarket.com
PMEX_GAMMA_API_BASE_URL=https://gamma-api.polymarket.com

# ─────────────────────────────────────────────────────────────────────────────
# BACKUPS
# ─────────────────────────────────────────────────────────────────────────────

PMEX_BACKUP_DIR=/var/backups/pmex
PMEX_BACKUP_MAX_AGE_HOURS=8

# ─────────────────────────────────────────────────────────────────────────────
# LIVE-MODE INTERLOCK — leave empty
# ─────────────────────────────────────────────────────────────────────────────
#
# One of three independent conditions required to trade real funds (FR-O-5); the
# other two are `mode: live` in the bot's YAML and the --live flag. Set this only
# when you deliberately mean it, and only after weeks of paper mode.
I_UNDERSTAND_THIS_TRADES_REAL_FUNDS=
