# Copy to .env and fill in. Never commit the real .env.

POSTGRES_PASSWORD=changeme
PMEX_DATABASE_URL=postgresql://postgres:changeme@db:5432/pmex

# Control plane (FR-C-7): refuses to start without this set. Generate with
# `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`.
PMEX_CONTROL_AUTH_SECRET=
# Read-only until explicitly enabled (FR-C-8).
PMEX_CONTROL_ALLOW_WRITES=0
# Host-side port the control plane is published on (container-internal port is
# always 8080). Override if 8877 collides with something else on your machine.
PMEX_CONTROL_HOST_PORT=8877

# Chain source (optional — FR-W-7; system remains functional on Data API alone).
# Needs a real WSS provider (Alchemy/QuickNode/Chainstack/dRPC) with reliable
# eth_subscribe — public endpoints mostly don't support persistent subscriptions.
POLYGON_RPC_URL=
POLYGON_WS_URL=
POLYGON_WS_URL_FALLBACK=
PMEX_SOURCES_CHAIN_ENABLED=1
PMEX_SOURCES_DATAAPI_ENABLED=1
PMEX_DATAAPI_POLL_INTERVAL_S=30

# CLOB / Data API / Gamma bases (defaults point at production, override for testing).
PMEX_CLOB_BASE_URL=https://clob.polymarket.com
PMEX_DATA_API_BASE_URL=https://data-api.polymarket.com
PMEX_GAMMA_API_BASE_URL=https://gamma-api.polymarket.com

PMEX_BACKUP_DIR=/var/backups/pmex
PMEX_BACKUP_MAX_AGE_HOURS=8

# Live-mode interlock (FR-O-5) — leave empty. Set only when you deliberately mean it.
I_UNDERSTAND_THIS_TRADES_REAL_FUNDS=
